{
  "mcpServers": {
    "fff": {
      "command": "fff-mcp",
      "args": [
        "--no-update-check"
      ]
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "betterstack": {
      "url": "https://mcp.betterstack.com"
    },
    "secureframe": {
      "url": "https://mcp.secureframe.com/"
    },
    "xapi": {
      "command": "npx",
      "args": [
        "-y",
        "@xdevplatform/xurl",
        "mcp",
        "https://api.x.com/mcp"
      ]
    },
    "workos": {
      "url": "https://mcp.workos.com/mcp"
    }
  }
}
