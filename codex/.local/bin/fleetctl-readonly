#!/bin/sh
set -eu

service=${FLEETCTL_READONLY_KEYCHAIN_SERVICE:-"fleet-observer-api-token"}
token=$(/usr/bin/security find-generic-password -a "$USER" -s "$service" -w 2>/dev/null) || {
  printf 'Fleet Observer token is not available in Keychain service %s\n' "$service" >&2
  exit 1
}

umask 077
runtime_root=$(mktemp -d "${TMPDIR:-/tmp}/fleetctl-readonly.XXXXXX")
config="$runtime_root/config"
: >"$config"
trap 'rm -rf -- "$runtime_root"' EXIT HUP INT TERM

MISE_STATE_DIR="$runtime_root/mise-state" CONFIG="$config" fleetctl config set \
  --address https://fleet.tractorbeam.tools \
  --token "$token" \
  >/dev/null
unset token

MISE_STATE_DIR="$runtime_root/mise-state" CONFIG="$config" fleetctl "$@"
