#!/usr/bin/env bash
# Refresh the shared Tractorbeam Identity Center session. Lives in the aws
# package, not a .zshrc alias, so a host that doesn't stow aws can supply its
# own aws-login.

# Claude Code runs background sessions with BROWSER=true, which turns the
# CLI's browser launch into a silent no-op. Honor it only over SSH, where it
# keeps the browser from opening on a machine nobody is looking at.
if [[ -z "${SSH_CONNECTION:-}" && "${BROWSER:-}" == "true" ]]; then
  unset BROWSER
fi

# The device code flow prints a URL and code that also work from another
# machine, which the default flow's localhost callback does not.
exec aws sso login --sso-session tractorbeam --use-device-code "$@"
