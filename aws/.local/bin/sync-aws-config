#!/usr/bin/env bash
set -euo pipefail

# Assemble ~/.aws/config from the tracked profiles plus optional host-local
# overlay. The result is a regular file, never a symlink into the repo, so
# host-local profiles cannot leak into git.

# Stow links this script into ~/.local/bin with a relative target, so resolve
# the link from its own directory rather than the caller's.
script="$0"
if [[ -L "$script" ]]; then
  script="$(cd "$(dirname "$script")" && cd "$(dirname "$(readlink "$script")")" && pwd)/$(basename "$script")"
fi
root="$(cd "$(dirname "$script")/../../.." && pwd)"
managed="$root/aws/.aws/config"
live="$HOME/.aws/config"
overlay="$HOME/.aws/config.local"
marker='# BEGIN TRACTORBEAM AGENT PROFILES'

[[ -f "$managed" ]] || {
  printf 'sync-aws-config: missing %s\n' "$managed" >&2
  exit 1
}

install -d -m 700 "$HOME/.aws"

# A symlink into the repo would make the write below a git change.
if [[ -L "$live" ]]; then
  rm "$live"
fi

# A generated agent-profile block in the overlay declares the same profiles as
# the tracked AGENTS section, and the AWS CLI rejects a config that declares a
# profile twice. The block runs from its marker to the end of the file. Remove
# this once no host's config.local carries one.
if [[ -f "$overlay" ]] && grep -qxF "$marker" "$overlay"; then
  awk -v m="$marker" '$0 == m { exit } { print }' "$overlay" >"$overlay.tmp"
  chmod 600 "$overlay.tmp"
  mv "$overlay.tmp" "$overlay"
fi

tmp="$(mktemp "$HOME/.aws/config.XXXXXX")"
{
  cat "$managed"
  if [[ -s "$overlay" ]]; then
    printf '\n'
    cat "$overlay"
  fi
} >"$tmp"
chmod 600 "$tmp"
mv "$tmp" "$live"
