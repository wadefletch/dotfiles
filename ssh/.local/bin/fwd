#!/usr/bin/env bash
# Forward localhost ports to the same ports on another Mac until interrupted:
#   fwd arrakis 3000 5173
set -euo pipefail
host=${1:?usage: fwd <host> <port>...}
shift
[[ $# -gt 0 ]] || { echo "usage: fwd <host> <port>..." >&2; exit 1; }
args=()
for port in "$@"; do
  args+=(-L "$port:localhost:$port")
done
echo "Forwarding ${*} to $host; Ctrl-C to stop."
exec ssh -N -o ExitOnForwardFailure=yes "${args[@]}" "$host"
