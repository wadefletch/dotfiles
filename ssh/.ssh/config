# Must be before any Host blocks
Include ~/.orbstack/ssh/config

Host *
  AddKeysToAgent yes
  IgnoreUnknown UseKeychain
  UseKeychain yes

Host proxmox
  SetEnv TERM=xterm-256color

# The Macs reach each other over the personal tailnet. Full MagicDNS names keep
# other search domains from answering the short ones, and each host key stays
# pinned under the short name.
Host arrakis
  HostName arrakis.calliope-cirius.ts.net
  HostKeyAlias arrakis
Host corrino
  HostName corrino.calliope-cirius.ts.net
  HostKeyAlias corrino
Host arrakis corrino
  User wadefletcher
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_tailnet
  IdentityFile ~/.ssh/id_github_wadefletch
  StrictHostKeyChecking yes
  UpdateHostKeys no
  UserKnownHostsFile ~/.ssh/known_hosts.private

# Tell the other Mac which device a session comes from, so open-url there opens
# browsers here. sshd accepts LC_* variables and mosh-server keeps them.
# originalhost, because host matches the substituted HostName.
Match originalhost arrakis,corrino exec "scutil --get LocalHostName | grep -qx Arrakis"
  SetEnv LC_CLIENT_DEVICE=arrakis
Match originalhost arrakis,corrino exec "scutil --get LocalHostName | grep -qx Corrino"
  SetEnv LC_CLIENT_DEVICE=corrino
