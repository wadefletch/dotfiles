# Must be before any Host blocks
Include ~/.orbstack/ssh/config

Host *
  AddKeysToAgent yes
  IgnoreUnknown UseKeychain
  UseKeychain yes

Host proxmox
  SetEnv TERM=xterm-256color

# Short names resolve via WARP's private.tractorbeam.tools search suffix.
Host arrakis corrino
  User wadefletcher
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_tailnet
  IdentityFile ~/.ssh/id_github_wadefletch
  StrictHostKeyChecking yes
  UpdateHostKeys no
  UserKnownHostsFile ~/.ssh/known_hosts.private

# Tell the other Mac which one a session comes from, so open-url there opens
# browsers here. sshd accepts LC_* variables and mosh-server keeps them.
Match host arrakis,corrino exec "scutil --get LocalHostName | grep -qx Arrakis"
  SetEnv LC_MESH_CLIENT=arrakis
Match host arrakis,corrino exec "scutil --get LocalHostName | grep -qx Corrino"
  SetEnv LC_MESH_CLIENT=corrino
