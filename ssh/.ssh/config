# Workspace-specific aliases are generated locally by `coder config-ssh`.
Include ~/.ssh/coder_config

# Must be before any Host blocks
Include ~/.orbstack/ssh/config

Host *
  AddKeysToAgent yes
  IgnoreUnknown UseKeychain
  UseKeychain yes

Host *github*
  ForwardAgent yes
  IdentityFile ~/.ssh/id_github_wadefletch

Host proxmox
  SetEnv TERM=xterm-256color

Host arrakis
  HostName arrakis.end-artichoke.ts.net

Host corrino
  HostName corrino.end-artichoke.ts.net

Host arrakis corrino
  User wadefletcher
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_tailnet
  IdentityFile ~/.ssh/id_github_wadefletch
  ForwardAgent no
  StrictHostKeyChecking yes
  UpdateHostKeys no
  UserKnownHostsFile ~/.ssh/known_hosts.tailnet

# Charlie's MacBook Air (Tailscale). Native sshd support access.
# No ForwardAgent — don't expose the local agent to another user's machine.
Host charlie
  HostName charlies-macbook-air.end-artichoke.ts.net
  User charliebrizz
  IdentityFile ~/.ssh/id_github_wadefletch
