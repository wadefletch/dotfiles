# Must be before any Host blocks
Include ~/.orbstack/ssh/config

Host *
  AddKeysToAgent yes
  IgnoreUnknown UseKeychain
  UseKeychain yes

Host *github*
  IdentityFile ~/.ssh/id_github_wadefletch

Host github.com
  StrictHostKeyChecking yes
  UpdateHostKeys no
  UserKnownHostsFile ~/.ssh/known_hosts.github

Host proxmox
  SetEnv TERM=xterm-256color

# Short names resolve via WARP's private.tractorbeam.tools search suffix.
Host arrakis corrino
  User wadefletcher
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_tailnet
  IdentityFile ~/.ssh/id_github_wadefletch
  StrictHostKeyChecking yes
  UpdateHostKeys no
  UserKnownHostsFile ~/.ssh/known_hosts.private

# Charlie's MacBook Air. Native sshd; no ForwardAgent.
Host charlie
  User charliebrizz
  IdentityFile ~/.ssh/id_github_wadefletch
