# Daily at 05:00 America/New_York (the devbox clock is UTC; the timezone suffix
# pins this to Eastern regardless). Persistent catches up a missed run — e.g. if
# the box was down at 05:00 — on the next start.
[Unit]
Description=Daily fast-forward of tiburon main

[Timer]
OnCalendar=*-*-* 05:00:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
