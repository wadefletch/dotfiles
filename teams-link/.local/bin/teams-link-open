#!/bin/sh
# Rewrite an msteams: URL to its Teams web-client equivalent and hand it to the
# default browser. Registered as the system msteams: handler so meeting links
# open in whatever browser is default, and never launch the Teams desktop app.
set -eu

url=${1:-}
[ -n "$url" ] || exit 0

# msteams:/l/…, msteams://l/… and msteams://teams.microsoft.com/l/… all reduce
# to the same /l/… path.
path=$(printf '%s' "$url" | sed -E 's|^msteams:(//)?(teams\.microsoft\.com)?||; s|^/*|/|')

case "$path" in
  # The v2 deep link drops straight into the web client, so the join page never
  # offers to hand the meeting off to the desktop app.
  /l/meetup-join/*) target="https://teams.microsoft.com/v2/?meetingjoin=true#$path" ;;
  *) target="https://teams.microsoft.com$path" ;;
esac

exec /usr/bin/open "$target"
