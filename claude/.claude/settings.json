{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "ENABLE_LSP_TOOL": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "true",
    "AWS_MCP_PROXY_PROFILES": "agent-read-management agent-read-audit agent-read-log-archive agent-read-production agent-read-nonprod agent-read-shared-services agent-read-distribution agent-read-sandbox agent-read-brizzco",
    "NODE_USE_ENV_PROXY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Bash(docker logs *)",
      "Bash(docker images *)",
      "Bash(docker run *)",
      "Bash(docker stop *)",
      "Bash(docker rm *)",
      "Read(~/.claude/plugins/**)",
      "Read(~/.claude/references/**)",
      "mcp__claude_ai_Linear__get_attachment",
      "mcp__claude_ai_Linear__get_document",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__get_issue_status",
      "mcp__claude_ai_Linear__get_milestone",
      "mcp__claude_ai_Linear__get_project",
      "mcp__claude_ai_Linear__get_status_updates",
      "mcp__claude_ai_Linear__get_team",
      "mcp__claude_ai_Linear__get_user",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__claude_ai_Linear__list_cycles",
      "mcp__claude_ai_Linear__list_documents",
      "mcp__claude_ai_Linear__list_issues",
      "mcp__claude_ai_Linear__list_issue_statuses",
      "mcp__claude_ai_Linear__list_issue_labels",
      "mcp__claude_ai_Linear__list_milestones",
      "mcp__claude_ai_Linear__list_projects",
      "mcp__claude_ai_Linear__list_project_labels",
      "mcp__claude_ai_Linear__list_teams",
      "mcp__claude_ai_Linear__list_users",
      "mcp__claude_ai_Linear__search_documentation",
      "mcp__claude_ai_Linear__extract_images",
      "mcp__claude_ai_Granola__query_granola_meetings",
      "mcp__claude_ai_Granola__list_meetings",
      "mcp__claude_ai_Granola__get_meetings",
      "mcp__claude_ai_Granola__get_meeting_transcript",
      "Read(~/.claude/memory/**)",
      "Edit(~/.claude/memory/**)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude/references"
    ]
  },
  "model": "opus",
  "skillOverrides": {
    "aws-core:signing-in-to-aws": "off"
  },
  "deniedMcpServers": [
    {
      "serverName": "plugin:aws-core:aws-mcp"
    }
  ],
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "aws-core@agent-toolkit-for-aws": true,
    "cloudflare@cloudflare": true,
    "code-style@tractorbeam": true,
    "document-skills@anthropic-agent-skills": true,
    "experimental@tractorbeam": true,
    "mise@tractorbeam": true,
    "plugin-dev@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "tractorbeam@tractorbeam": true,
    "typescript-lsp@claude-plugins-official": true,
    "workos@workos": true
  },
  "extraKnownMarketplaces": {
    "agent-toolkit-for-aws": {
      "source": {
        "source": "github",
        "repo": "aws/agent-toolkit-for-aws"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "workos": {
      "source": {
        "source": "github",
        "repo": "workos/skills"
      }
    },
    "tractorbeam": {
      "source": {
        "source": "git",
        "url": "https://github.com/tractorbeamai/skills.git"
      },
      "autoUpdate": true
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "feedbackDrafts": "off",
  "showClearContextOnPlanAccept": true,
  "askUserQuestionTimeout": "60s",
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "verbose": true,
  "preferredNotifChannel": "ghostty",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "docker *",
      "rsync *",
      "scp *",
      "sftp *",
      "ssh *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.aws/cli/cache",
        "~/.aws/sso/cache",
        "~/.bun",
        "~/.cache",
        "~/.cargo/bin",
        "~/.cargo/git",
        "~/.cargo/registry",
        "~/.config/gh",
        "~/.config/rwx/lsp-server",
        "~/.kube",
        "~/.local/bin",
        "~/.local/share/mise",
        "~/.local/share/pnpm",
        "~/.local/share/uv",
        "~/.local/state/mise",
        "~/.npm",
        "~/.rustup",
        "~/.terraform.d",
        "~/Library/Application Support/com.vercel.cli",
        "~/Library/Caches",
        "~/Library/Preferences/.wrangler",
        "~/Library/pnpm"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowAllUnixSockets": true,
      "allowedDomains": [
        "*.amazonaws.com",
        "*.anthropic.com",
        "*.aws.amazon.com",
        "*.claude.ai",
        "*.claude.com",
        "*.cloudflare.com",
        "*.crates.io",
        "*.docker.com",
        "*.docker.io",
        "*.github.com",
        "*.githubusercontent.com",
        "*.linear.app",
        "*.npmjs.com",
        "*.npmjs.org",
        "*.rust-lang.org",
        "*.tractorbeam.ai",
        "*.vercel.app",
        "*.vercel.com",
        "*.workers.dev",
        "*.workos.com",
        "*.yarnpkg.com",
        "100.96.0.3",
        "100.96.0.8",
        "arrakis",
        "bun.sh",
        "corrino",
        "crates.io",
        "files.pythonhosted.org",
        "ghcr.io",
        "github.com",
        "jsr.io",
        "mise.jdx.dev",
        "nodejs.org",
        "proxy.golang.org",
        "pypi.org",
        "registry.terraform.io",
        "releases.hashicorp.com",
        "sum.golang.org"
      ]
    }
  }
}
