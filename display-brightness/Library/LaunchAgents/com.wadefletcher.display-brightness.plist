<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wadefletcher.display-brightness</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/wadefletcher/.local/bin/display-brightness.sh</string>
	</array>
	<!-- The appearance is stored in the global preferences; the interval
	     catches switches the watch misses and retries until BetterDisplay
	     is running. -->
	<key>WatchPaths</key>
	<array>
		<string>/Users/wadefletcher/Library/Preferences/.GlobalPreferences.plist</string>
	</array>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/display-brightness.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/display-brightness.log</string>
</dict>
</plist>
