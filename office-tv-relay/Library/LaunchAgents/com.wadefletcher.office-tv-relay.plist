<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wadefletcher.office-tv-relay</string>
	<!-- Bun via mise. The first start triggers macOS's Local Network prompt;
	     allow it so the relay can reach the TV. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec "$HOME/.local/share/mise/shims/bun" "$HOME/.local/share/office-tv-relay/relay.ts"</string>
	</array>
	<!-- A long-running service: start at login, restart if it exits. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/tmp/office-tv-relay.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/office-tv-relay.log</string>
</dict>
</plist>
