# Fast-forward the tiburon primary checkout to origin/main when safe.
# Triggered by git-auto-ff.timer; run manually with: systemctl --user start git-auto-ff.
[Unit]
Description=Fast-forward tiburon main to origin when safe
Documentation=man:git-fetch(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/git-auto-ff
