<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wadefletcher.git-auto-ff</string>
	<!-- launchd doesn't expand ~ or $HOME in ProgramArguments; sh does. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec "$HOME/.local/bin/git-auto-ff"</string>
	</array>
	<!-- 05:00 local time; a run missed while asleep fires on wake. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>5</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/tmp/git-auto-ff.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/git-auto-ff.log</string>
</dict>
</plist>
